{
  "manifest_version": 3,
  "name": "product-review-bridge",
  "version": "0.1.0",
  "description": "Cầu nối local: nhận lệnh tạo ảnh từ Product Review (Tools Hub), gửi trong tab ChatGPT/Google Flow đang đăng nhập và trả ảnh về máy.",
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://flow.google.com/*",
    "https://flow-content.google/*"
  ],
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*"], "js": ["content-common.js", "content-chatgpt.js"], "run_at": "document_idle" },
    { "matches": ["https://flow.google.com/*"], "js": ["content-common.js", "content-flow.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "product-review-bridge", "default_popup": "popup.html" }
}
