# Machine-local state: hub/ (version, backups) and each tool's own workspace. Base data stays versioned.
/workspace/
/apps/*/workspace/
/apps/*/bridge/node_modules/
/worker/.wrangler/
/worker/*/.wrangler/
# Sample photos are downloaded per group from Drive; only the catalog is versioned.
/apps/*/data/source-photos/*/
.DS_Store
